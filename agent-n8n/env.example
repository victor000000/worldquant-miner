# Agent Network Environment Variables

# Moonshot API Key (Required)
MOONSHOT_API_KEY=

# WorldQuant Brain Credentials (Required)
# Create credentials/credential.txt with: ["username", "password"]

# Agent Hub Configuration
AGENT_HUB_URL=http://localhost:8000
AGENT_HUB_USERNAME=
AGENT_HUB_PASSWORD=
# Set a private random signing value of at least 32 characters.
JWT_SECRET=

# n8n Configuration
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# Database Configuration
POSTGRES_DB=agent_network
POSTGRES_USER=agent_user
# Supply the same password in the URL, URL-encoded where needed.
AGENT_DB_PASSWORD=
AGENT_DATABASE_URL=

# Redis Configuration
REDIS_URL=redis://redis:6379

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=

# Optional: Custom URLs for external access
NEXT_PUBLIC_AGENT_HUB_URL=http://localhost:8000
NEXT_PUBLIC_N8N_URL=http://localhost:5678
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Optional: Development settings
DEBUG=false
LOG_LEVEL=INFO 